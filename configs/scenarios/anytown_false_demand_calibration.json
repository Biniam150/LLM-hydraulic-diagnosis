{
  "network": "anytown",
  "purpose": "Test whether a single-node demand-only calibration can reduce pressure error when demand is not the true source of mismatch.",
  "design_rules": [
    "The demand-only calibrator receives observations but not the injected cause.",
    "The calibrator searches every AnyTown demand junction using the demand multipliers frozen in configs/networks/anytown.json.",
    "A non-demand case is a false calibration when pressure MAE improves by at least 10 percent.",
    "Strong or moderate demand evidence in a non-demand case is a false causal attribution."
  ],
  "seeds": [
    101,
    202,
    404
  ],
  "scenarios": [
    {
      "id": "true_demand_control",
      "fault": {
        "fault_type": "demand_error",
        "target": "90",
        "start_hour": 0,
        "end_hour": 24,
        "magnitude": 1.5
      }
    },
    {
      "id": "roughness_mismatch",
      "fault": {
        "fault_type": "roughness_error",
        "target": "24",
        "start_hour": 0,
        "end_hour": 24,
        "magnitude": 0.6
      }
    },
    {
      "id": "leak_mismatch",
      "fault": {
        "fault_type": "leak",
        "target": "90",
        "start_hour": 8,
        "end_hour": 24,
        "magnitude": 0.001
      }
    },
    {
      "id": "sensor_bias_mismatch",
      "fault": {
        "fault_type": "sensor_bias",
        "target": "100",
        "start_hour": 8,
        "end_hour": 24,
        "magnitude": -0.8
      }
    },
    {
      "id": "source_head_mismatch",
      "fault": {
        "fault_type": "source_head",
        "target": "10",
        "start_hour": 0,
        "end_hour": 24,
        "magnitude": -2.0
      }
    },
    {
      "id": "no_fault_control",
      "fault": {
        "fault_type": "no_fault",
        "target": "90",
        "start_hour": 0,
        "end_hour": 24,
        "magnitude": 0.0
      }
    }
  ]
}
